# Password for /admin (creating galleries & uploading photos).
# Change this to something only you know.
ADMIN_PASSWORD=changeme

# A long random string used to sign admin session cookies.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# These are created automatically when you install the Upstash Redis
# integration from the Vercel Marketplace (Vercel KV was retired — this
# is its replacement). Depending on how you install it, you may see either
# KV_REST_API_URL/KV_REST_API_TOKEN or UPSTASH_REDIS_REST_URL/TOKEN — the
# app reads either naming automatically, so whichever appears is fine.
BLOB_READ_WRITE_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Shown to you when you enable Cron Jobs in the Vercel dashboard, used to
# secure the daily cleanup job so randoms can't trigger it.
CRON_SECRET=
